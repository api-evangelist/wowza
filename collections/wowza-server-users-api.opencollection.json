          },
          "http": {
            "method": "POST",
            "url": "http://localhost:8087/v2/servers/:serverName/users/:userName",
            "params": [
              {
                "name": "serverName",
                "value": "",
                "type": "path",
                "description": "Reserved for future use"
              },
              {
                "name": "userName",
                "value": "",
                "type": "path",
                "description": "The user name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds the specified user configuration. This API is available in builds 15089 or later."

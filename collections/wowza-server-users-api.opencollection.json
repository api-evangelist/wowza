{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wowza Streaming Engine REST advanced_token_authentication Server Users API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Server Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get user list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8087/v2/servers/:serverName/users",
            "params": [
              {
                "name": "serverName",
                "value": "",
                "type": "path",
                "description": "Reserved for future use"
              }
            ]
          },
          "docs": "Retrieves the list of server users. This API is available in builds 15089 or later."
        },
        {
          "info": {
            "name": "Update user list",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:8087/v2/servers/:serverName/users",
            "params": [
              {
                "name": "serverName",
                "value": "",
                "type": "path",
                "description": "Reserved for future use"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds a new server user to the list. This API is available in builds 15089 or later."
        },
        {
          "info": {
            "name": "Get user",
            "type": "http"
          },
